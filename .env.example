APP_NAME=Visual Inspection & Defect Root-Cause Assistant
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./app.db

RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
UPLOAD_DATA_PATH=data/uploads
REPORT_DATA_PATH=data/reports
MODEL_PATH=models/uploaded
ACTIVE_MODEL_PATH=models/active

CONFIDENCE_THRESHOLD=0.50
ENABLE_ROOT_CAUSE_ANALYSIS=True
ENABLE_BOTTLENECK_ANALYSIS=True
ENABLE_ECONOMIC_ANALYSIS=True
ENABLE_WHAT_IF_SIMULATION=True

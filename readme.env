# ==============================
# APPLICATION
# ==============================
APP_NAME=Visual Inspection & Defect Root-Cause Assistant
ENVIRONMENT=development
DEBUG=True

# ==============================
# DATA PATHS
# ==============================
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
MODEL_PATH=models

# ==============================
# STREAMLIT
# ==============================
STREAMLIT_SERVER_PORT=8501

# ==============================
# AI / ML
# ==============================
MODEL_TYPE=auto
CONFIDENCE_THRESHOLD=0.50
NOVELTY_DETECTION=True

# ==============================
# ANALYSIS
# ==============================
ENABLE_ROOT_CAUSE_ANALYSIS=True
ENABLE_BOTTLENECK_ANALYSIS=True
ENABLE_ECONOMIC_ANALYSIS=True
ENABLE_WHAT_IF_SIMULATION=True

# ==============================
# OPTIONAL API KEYS
# Add real keys only if your
# implementation actually uses them
# ==============================
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ==============================
# DATABASE - OPTIONAL
# ==============================
DATABASE_URL=

# ==============================
# LOGGING
# ==============================
LOG_LEVEL=INFO



